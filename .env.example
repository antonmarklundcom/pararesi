# Every variable below is declared once in src/config/env.ts, which classifies it
# as required-in-production, required-for-a-feature, or optional, and is the only
# place the app reads process.env for these values. Check a deployment against
# that classification with `npx tsx scripts/preflight.ts`.

# --- App (required in production: the app refuses to boot without these) ---
# Canonical https URL, no trailing slash. Used in emails, checkout redirects, sitemap/robots.
# In production this must be https and must not be localhost.
APP_URL=http://localhost:3000
# 32+ random chars for iron-session cookie encryption. Generate: openssl rand -base64 32
SESSION_SECRET=
# How many trusted proxies sit in front of the app, for reading the client IP out
# of x-forwarded-for (rate limiting). 1 = the Hostinger reverse proxy only, which
# is the default and almost certainly what you want. Raise it only if you put a
# CDN in front as well — setting it too high lets callers spoof their own IP and
# bypass every rate limit. See src/lib/request-ip.ts.
TRUSTED_PROXY_HOPS=1

# --- Database (required in production; Hostinger MySQL; host is usually localhost on the same slot) ---
# mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=

# --- Lemon Squeezy (feature: checkout + webhooks. Settings -> API for the key;
#     Store settings for the store id). Unset = no checkout and no entitlement
#     grants; preflight treats every one of these as a launch blocker. ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Set when creating the webhook endpoint in the Lemon Squeezy dashboard.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs from the Lemon Squeezy dashboard (Products -> variant -> copy ID).
# Test-mode and live-mode ids are DIFFERENT — preflight resolves each one against
# the API and warns when a test-mode key is paired with a live APP_URL.
LS_VARIANT_GUIDE=
LS_VARIANT_INSIDER_MONTHLY=
LS_VARIANT_INSIDER_YEARLY=

# --- Email (feature; unset in dev = emails log to console instead of sending) ---
RESEND_API_KEY=
# e.g. "Paraguay Residency Guide <hello@yourdomain.com>" - domain must be verified in Resend.
EMAIL_FROM=

# --- Cron (feature: POST /api/cron/nurture, once a day) ---
# Shared secret sent as "Authorization: Bearer ...". Unset = the endpoint 401s,
# so the nurture sequence simply doesn't run. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Optional: reported by GET /api/health so you can tell which build is live.
#     Set it in the deploy step, e.g. GIT_COMMIT_SHA=$(git rev-parse HEAD) ---
GIT_COMMIT_SHA=

# --- Seed scripts only (scripts/seed-admin.ts); not read at runtime ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Analytics (Plausible; cookieless, no-op when unset) ---
# The site domain as registered in your Plausible project, e.g. yourdomain.com.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

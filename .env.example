# --- App ---
# Canonical https URL, no trailing slash. Used in emails, checkout redirects, sitemap/robots.
APP_URL=http://localhost:3000
# 32+ random chars for iron-session cookie encryption. Generate: openssl rand -base64 32
SESSION_SECRET=

# --- Database (Hostinger MySQL; host is usually localhost on the same slot) ---
# mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=

# --- Lemon Squeezy (Settings -> API for the key; Store settings for the store id) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Set when creating the webhook endpoint in the Lemon Squeezy dashboard.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs from the Lemon Squeezy dashboard (Products -> variant -> copy ID).
LS_VARIANT_GUIDE=
LS_VARIANT_INSIDER_MONTHLY=
LS_VARIANT_INSIDER_YEARLY=

# --- Email (Resend; unset in dev = emails log to console instead of sending) ---
RESEND_API_KEY=
# e.g. "Paraguay Residency Guide <hello@yourdomain.com>" - domain must be verified in Resend.
EMAIL_FROM=

# --- Cron (POST /api/cron/nurture, once a day) ---
# Shared secret sent as "Authorization: Bearer ...". Unset = the endpoint 401s,
# so the nurture sequence simply doesn't run. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Seed scripts only (scripts/seed-admin.ts); not read at runtime ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Analytics (Plausible; cookieless, no-op when unset) ---
# The site domain as registered in your Plausible project, e.g. yourdomain.com.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
